{
  "name": "daily",
  "description": "Local agent workbench powered by Electron, React, and a Rust sidecar",
  "author": "JinXingJX",
  "license": "MIT",
  "homepage": "https://github.com/JinXingJX/daily",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinXingJX/daily.git"
  },
  "bugs": {
    "url": "https://github.com/JinXingJX/daily/issues"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "backend:check": "cargo check --workspace",
    "backend:build": "cargo build -p daily-app-server",
    "backend:release": "cargo build --release -p daily-app-server",
    "dev": "npm run backend:build && electron-vite dev --watch",
    "dev:web": "vite",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "check:protocol": "node scripts/gen-protocol.mjs --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package:mac": "npm run backend:release && npm run build && electron-builder --mac zip --arm64 && bash scripts/create-dmg.sh",
    "test:rust": "cargo test --workspace",
    "test:renderer": "vitest run src",
    "test:electron": "npm run backend:build && vitest run electron/**/*.test.ts",
    "test": "npm run test:rust && npm run check:protocol && npm run test:renderer && npm run test:electron && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.42",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "@tailwindcss/vite": "^4.2.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.11.1",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.jinxingjx.daily",
    "productName": "Daily",
    "copyright": "Copyright © 2026 JinXingJX",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build/icons"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/daily-app-server",
        "to": "bin/daily-app-server"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
